{
  "name": "sat-rush-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Automated strategy client for Sat Rush (Solana on-chain game)",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "config": "tsx src/config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx test/sim.ts",
    "preflight": "tsx scripts/preflight.ts",
    "prices": "tsx scripts/check-prices.ts",
    "epoch-uplift": "tsx scripts/epoch-uplift.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "switch:devnet": "bash scripts/switch-cluster.sh devnet",
    "switch:mainnet": "bash scripts/switch-cluster.sh mainnet",
    "measure-volume": "tsx scripts/measure-volume.ts",
    "epoch-history": "tsx scripts/epoch-history.ts",
    "epoch-concentration": "tsx scripts/epoch-concentration.ts",
    "tile-bias": "tsx scripts/tile-bias.ts",
    "epoch-field": "tsx scripts/epoch-field.ts",
    "epoch-pool-raw": "tsx scripts/epoch-pool-raw.ts",
    "hashrate-balance": "tsx scripts/hashrate-balance.ts",
    "v2-strategy": "tsx scripts/v2-strategy.ts",
    "wallet-set": "tsx scripts/wallet-set.ts",
    "v2-ledger": "tsx scripts/v2-ledger.ts",
    "idl:gen": "tsx scripts/idl/gen-idl-from-sdk.ts",
    "idl:verify": "tsx scripts/idl/verify-idl-live.ts",
    "vault-carry": "tsx scripts/vault-carry.ts",
    "v1:wait-launch": "tsx scripts/v1/wait-for-mainnet.ts",
    "v1:accrual-ev": "tsx scripts/v1/accrual-ev.ts",
    "v1:dedup-effect": "tsx scripts/v1/dedup-effect.ts",
    "v1:sybil-curve": "tsx scripts/v1/sybil-curve.ts",
    "v1:strategy-compare": "tsx scripts/v1/strategy-compare.ts",
    "v1:sats-drift": "tsx scripts/v1/sats-drift.ts",
    "v1:farming-verdict": "tsx scripts/v1/farming-verdict.ts",
    "v1:farming-audit": "tsx scripts/v1/farming-audit.ts",
    "v1:reconcile-ev": "tsx scripts/v1/reconcile-ev.ts",
    "v1:recompute": "tsx scripts/v1/recompute.ts",
    "v1:fire-timing": "tsx scripts/v1/fire-timing.ts",
    "v1:redesign-model": "tsx scripts/v1/redesign-model.ts",
    "v1:strike-concentration": "tsx scripts/v1/strike-concentration.ts",
    "v1:v2-edge": "tsx scripts/v1/v2-edge.ts",
    "v1:carry-check": "tsx scripts/v1/carry-check.ts",
    "v1:full-accounting": "tsx scripts/v1/full-accounting.ts",
    "mint-rule": "tsx scripts/mint-rule.ts",
    "staking-yield": "tsx scripts/staking-yield.ts",
    "v2-timing": "tsx scripts/v2-timing.ts",
    "streak-ramp": "tsx scripts/streak-ramp.ts",
    "hold-vs-stake": "tsx scripts/hold-vs-stake.ts",
    "buy-vs-mine": "tsx scripts/buy-vs-mine.ts",
    "strike-payout": "tsx scripts/strike-payout.ts",
    "ev-map": "tsx scripts/ev-map.ts",
    "measure-remaining": "tsx scripts/measure-remaining.ts",
    "ev-grid": "tsx scripts/ev-grid.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@satrush/api": "^0.1.21",
    "@satrush/client": "^0.1.15",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.8",
    "@triton-one/yellowstone-grpc": "^5.0.9",
    "better-sqlite3": "^13.0.2",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.45.1",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
