{
  "name": "sat-rush-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Automated strategy client for Sat Rush (Solana on-chain game)",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "config": "tsx src/config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx test/sim.ts",
    "preflight": "tsx scripts/preflight.ts",
    "prices": "tsx scripts/check-prices.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "switch:devnet": "bash scripts/switch-cluster.sh devnet",
    "switch:mainnet": "bash scripts/switch-cluster.sh mainnet",
    "wait:launch": "tsx scripts/wait-for-mainnet.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.8",
    "@triton-one/yellowstone-grpc": "^5.0.9",
    "better-sqlite3": "^13.0.2",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.45.1",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}