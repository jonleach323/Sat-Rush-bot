{
  "name": "sat-rush-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Automated strategy client for Sat Rush (Solana on-chain game)",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "config": "tsx src/config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx test/sim.ts",
    "preflight": "tsx scripts/preflight.ts",
    "prices": "tsx scripts/check-prices.ts",
    "epoch-uplift": "tsx scripts/epoch-uplift.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "switch:devnet": "bash scripts/switch-cluster.sh devnet",
    "switch:mainnet": "bash scripts/switch-cluster.sh mainnet",
    "wait:launch": "tsx scripts/wait-for-mainnet.ts",
    "accrual-ev": "tsx scripts/accrual-ev.ts",
    "measure-volume": "tsx scripts/measure-volume.ts",
    "dedup-effect": "tsx scripts/dedup-effect.ts",
    "epoch-history": "tsx scripts/epoch-history.ts",
    "sybil-curve": "tsx scripts/sybil-curve.ts",
    "strategy-compare": "tsx scripts/strategy-compare.ts",
    "epoch-concentration": "tsx scripts/epoch-concentration.ts",
    "sats-drift": "tsx scripts/sats-drift.ts",
    "tile-bias": "tsx scripts/tile-bias.ts",
    "farming-verdict": "tsx scripts/farming-verdict.ts",
    "farming-audit": "tsx scripts/farming-audit.ts",
    "epoch-field": "tsx scripts/epoch-field.ts",
    "epoch-pool-raw": "tsx scripts/epoch-pool-raw.ts",
    "hashrate-balance": "tsx scripts/hashrate-balance.ts",
    "reconcile-ev": "tsx scripts/reconcile-ev.ts",
    "recompute": "tsx scripts/recompute.ts",
    "fire-timing": "tsx scripts/fire-timing.ts",
    "redesign-model": "tsx scripts/redesign-model.ts",
    "strike-concentration": "tsx scripts/strike-concentration.ts",
    "v2-edge": "tsx scripts/v2-edge.ts",
    "carry-check": "tsx scripts/carry-check.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@satrush/api": "^0.1.14",
    "@satrush/client": "^0.1.12",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.8",
    "@triton-one/yellowstone-grpc": "^5.0.9",
    "better-sqlite3": "^13.0.2",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.45.1",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
