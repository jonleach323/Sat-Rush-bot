# ── Execution gate ───────────────────────────────────────────────────────────
# dry (default): never sends transactions. devnet: sends on devnet.
# mainnet: sends on mainnet AND requires MAINNET_CONFIRM=yes.
EXECUTION_MODE=dry
# MAINNET_CONFIRM=yes

# ── RPC / streaming ──────────────────────────────────────────────────────────
# Helius: https://mainnet.helius-rpc.com/?api-key=<KEY> (or devnet.helius-rpc.com)
RPC_HTTP_URL=https://api.devnet.solana.com
# Comma-separated fallback/broadcast RPCs — the deploy is race-sent to ALL of
# them at once (identical signature, so duplicate lands are impossible). Put the
# lowest-latency staked/Sender endpoint FIRST. Helius Sender (SLC, no API key,
# dual-routes to validators + Jito): http://slc-sender.helius-rpc.com/fast
# NOTE: Helius Sender REQUIRES a Jito tip in the tx (min ~0.001 SOL — verify in
# Helius docs); set JITO_* below so every deploy carries a tip.
SECONDARY_RPC_URLS=
# Yellowstone-compatible gRPC endpoint + token.
# Helius LaserStream: https://laserstream-<cluster>-<region>.helius-rpc.com
# (verified: mainnet-slc, devnet-ewr; GRPC_TOKEN = the API key)
GRPC_URL=
GRPC_TOKEN=
# Optional Jito block engine for tip-routed sends (bundle path also needs a
# tip account; tips are embedded in the candidate transactions)
# Jito block engine (regional — Salt Lake City: https://slc.mainnet.block-engine.jito.wtf)
JITO_BLOCK_ENGINE_URL=
# Single tip account (legacy). Prefer JITO_TIP_ACCOUNTS below.
JITO_TIP_ACCOUNT=
# Jito tip accounts (comma list) — one is picked at random per fire to avoid the
# write-lock hotspot of tipping one account every round. These are HELIUS Sender's
# tip accounts (from Helius) — the correct set to tip when Helius Sender is your
# send path; Sender routes to validators + Jito internally, so a tip is embedded
# on every fire whether or not JITO_BLOCK_ENGINE_URL is set.
JITO_TIP_ACCOUNTS=4ACfpUFoaSD9bfPdeu6DBt89gB6ENTeHBXCAi87NhDEE,D2L6yPZ2FmmmTKPgzaMKdhu6EWZcTpLy1Vhx8uvZe7NZ,9bnz4RShgq1hAnLnZbP8kbgBg1kEmcJBYQq3gQbmnSta,5VY91ws6B2hMmBFRsXkoAAdsPHBJwRfBht4DXox3xkwn,2nyhqdwKcJZR2vcqCyrYsaPVdAnFoJjiksCXJ7hfEYgD,2q5pghRs6arqVjRvT5gfgWfWcHWmw1ZuCzphgd5KfWGJ,wyvPkWjVZz1M8fHQnMMCDTQDbkManefNNhweYk5WkcF,3KCKozbAaF75qEU33jtzozcJ29yJuaLJTy2jFdzUY8bT,4vieeGHPYPG2MmyPRcYjdiDmmhN3ww7hsFNap8pVN3Ey,4TQLFNWK8AovT1gFvda5jfw2oJeRMKEmw7aH6MGBJ3or
# Base (floor) tip, always paid when Jito is configured. Helius Sender needs
# ~0.001 SOL = 1000000 lamports minimum, so use that floor if you use Sender.
JITO_TIP_LAMPORTS=10000
# EV-scaled tipping: bid this fraction of a round's modeled EV as tip on top of
# the base — outbids rivals for inclusion on fat rounds, floors on thin ones.
# Clamped to JITO_TIP_MAX_LAMPORTS. 0 = flat base tip. Only active once the Jito
# URL + tip account above are set.
JITO_TIP_EV_FRACTION=0.1
JITO_TIP_MAX_LAMPORTS=1000000
# SOL price (USD) used to convert EV into tip lamports. COLD-START SEED ONLY —
# the live Pyth feed is authoritative; see the price-oracle block below.
SOL_USD_ESTIMATE=75

# Priority fee clamp (micro-lamports per CU) and deploy compute budget
PRIORITY_FEE_MIN_MICROLAMPORTS=1000
PRIORITY_FEE_MAX_MICROLAMPORTS=1000000
DEPLOY_CU_LIMIT=400000

# ── Identity / program ───────────────────────────────────────────────────────
KEYPAIR_PATH=./keypairs/operator.json
PROGRAM_ID=satRushGBRY2vgapeTAkoxz26vL2cYqyPi6CnBj7Tco
# Optional — resolved from the on-chain SatrushConfig when unset
USD_MINT=
BTC_MINT=

# ── Strategy / timing ────────────────────────────────────────────────────────
# water_filling (default) | k_emptiest (fallback)
STRATEGY=water_filling
# TileStake.stake interpretation — ANSWERED: raw net USD (FINDINGS.md E1)
STAKE_SEMANTICS=raw
# Stake sizing multiplier when strike pool exceeds the threshold (1.0 = off).
# Crude manual override — superseded by STRIKE_EV_ENABLED, which values the
# jackpot properly and lets Kelly size it. Leave at 1.0.
STRIKE_SIZE_BOOST=1.0
STRIKE_BOOST_THRESHOLD_USD=100
# Credit the expected strike jackpot into each round's EV. Sat Strike fires when
# rng % strike_trigger_modulus == 0 — a truly random ~1/1440 draw (per the IDL)
# that rolls the accumulated jackpot onto the winning tile's stakers. It can't be
# timed, but its expectation (jackpot / modulus) is real and grows with the
# pending pool, so late-cycle rounds are richer and full-Kelly sizes up on them
# automatically. On by default (simply more accurate EV).
STRIKE_EV_ENABLED=true
# Fraction of the Strike pool that actually reaches the winning tile's stakers.
# A reserve is retained at trigger and seeds the NEXT strike, so it is real
# value but not value this round can win. MEASURED n=1: round 13023 paid
# $1133.85 of a $1214.84 pool = 0.9333. The mechanic is new (the prior strike,
# round 10695, reserved nothing and paid 100%), so re-measure: RoundRevealed
# reports the true strike_bonus_usd, which can be checked against the pool.
STRIKE_PAYOUT_FRACTION=0.9333
# How many slots before end_slot to fire the deploy.
# Measured (FINDINGS.md E4): floor is 3 on public RPC (2/1/0 → 6005);
# 4 = floor + 1 cushion. Revisit ~2 when colocated with the RPC.
FIRE_OFFSET_SLOTS=4
# Adaptive fire timing: self-calibrate the offset from measured land latency so
# the bot fires as late as safely possible (fresher board, smaller window for
# others to react/crowd your tiles) and re-tunes as the send path changes. As a
# staked/Jito send lowers your latency, this drops the offset on its own. A miss
# costs only the tx fee, never USDC. Off = always use the static FIRE_OFFSET_SLOTS.
ADAPTIVE_FIRE_OFFSET=true
# Fraction of fires that must land in time. The offset is this quantile of land
# latency + cushion, taken over landed AND missed deploys — a miss is a censored
# observation (its latency exceeded the offset we used), so it pushes the offset
# WIDER. Higher = safer/earlier; lower = later/more aggressive. At 0.95 a miss
# rate under 5% leaves the offset untouched; above that it escalates toward the
# ceiling until misses come back inside budget.
FIRE_OFFSET_TARGET_LAND_PROB=0.95
# Extra slots added to the latency quantile (guards the program-level cutoff,
# where a deploy landing exactly on end_slot can still miss).
FIRE_OFFSET_CUSHION_SLOTS=1
# Hard bounds on the adaptive offset. Floor = never fire later than this (the
# measured program floor is ~2-3); ceiling = never fire earlier than this.
FIRE_OFFSET_FLOOR=2
FIRE_OFFSET_CEILING=6
# Landed-deploy samples required before the adaptive offset engages (until then
# it uses the static FIRE_OFFSET_SLOTS).
FIRE_OFFSET_MIN_SAMPLES=20
# Pick among the K emptiest tiles
K_EMPTIEST=3
# Endgame convergence [0..1]: thin tiles don't stay thin — late money and other
# snipers flood the cheapest tiles before close (a $12 board settled near-uniform
# at ~$10/tile once the field arrived). This pulls every below-mean tile this
# fraction of the way to the board mean in the forecast, so the model prices the
# payout dilution a thin snipe actually suffers instead of assuming it owns the
# tile alone. 0 = off (old optimistic behavior). Calibrated from live data where
# wins paid ~2× vs the ~3.1× needed to break even; revisit as the sample grows.
ENDGAME_CONVERGENCE=0.5
# Minimum modeled edge to fire, in bps of the gross deploy. Without it the
# selector fires on any EV>0, including thin edges that a slightly-optimistic
# forecast turns negative in reality. 200 = require modeled EV >= 2% of stake.
# 0 = off.
#
# CALIBRATION (live, 2026-08-06, n=98): with ENDGAME_CONVERGENCE on, average
# modeled edge was 368 bps and realized was +552 bps — roughly calibrated,
# slightly pessimistic. The old default of 1000 came from PRE-convergence data
# (model overstated edge by ~2150 bps then) and blocks the band that is now
# profitable. Re-measure as the post-fix sample grows:
#   sqlite3 data/satrush.db "SELECT date(d.created_at) day, COUNT(*) n,
#     ROUND(AVG(d.ev_expected/CAST(d.amount AS REAL))*10000) modeled_bps,
#     ROUND((SUM(CAST(s.won_usd AS REAL))-SUM(CAST(d.amount AS REAL)))
#           /SUM(CAST(d.amount AS REAL))*10000) realized_bps
#     FROM my_deploys d JOIN settlements s ON s.round_id=d.round_id
#     WHERE d.status='landed' GROUP BY day ORDER BY day;"
# realized >= modeled consistently -> lower toward 0; realized < modeled -> raise.
MIN_EDGE_BPS=200
# Fractional-Kelly bet sizing [0..1]. Caps each round's total stake at this
# fraction of the growth-optimal Kelly bet, sized to the live wallet bankroll —
# bigger on fat edges, smaller on thin/high-variance ones. Only ever reduces
# below the EV-max water-filling stake (betting past Kelly lowers long-run
# growth), never above MAX_PER_ROUND_USD.
#   1.0 = full Kelly (default): growth-maximizing bet, max long-run extraction —
#         optimal WHEN the edge estimate is accurate.
#   0.5 = half-Kelly: ~75% of the growth for ~50% the variance; robust if the
#         edge is uncertain (e.g. right after a model change).
#   0   = off (pure EV-max water-filling).
# Values above 1.0 are rejected at load — over-betting Kelly provably lowers growth.
KELLY_FRACTION=1.0
# Anti-collision: fold profiled rival occupancy into the selector's forecast so
# it routes off tiles other snipers will crowd — the TARGETED crowding signal
# (which tiles specific snipers chase). Composes with ENDGAME_CONVERGENCE (the
# blanket "cheap tiles fill toward the mean" signal): the predictor adds rival
# inflow first, then convergence fills the residual gap to the mean, so the two
# are bounded, not double-counted. If the bot is too conservative with both on,
# lower ENDGAME_CONVERGENCE first. On by default (the campaign field is crowded).
ANTI_COLLISION_ENABLED=true
# How many recent competitor deploys to profile for anti-collision.
COMPETITOR_LOOKBACK=500
# Comma-separated stake sizes in whole USD, e.g. 1,2,5
STAKE_LADDER_USD=1

# ── Risk limits (load-bearing — enforced in the execution path) ──────────────
MAX_PER_ROUND_USD=1
DAILY_LOSS_CAP_USD=5
# Claim once unclaimed winnings exceed this USD value
MAX_UNCLAIMED_USD_VALUE=50
# If this file exists, all transaction sending halts immediately
KILL_SWITCH_FILE=./KILL

# Ingest streams are considered stale after this many ms without updates
STALENESS_MS=1500
# Snapshot-vs-head lag. STALENESS_MS above only catches a stream that goes
# QUIET; a stream that keeps delivering on time from N slots BEHIND head looks
# perfectly healthy. That case is the dangerous one — slotsToCutoff() is derived
# from the lagged slot, so the bot thinks the round has N more slots than it
# does and fires into a closed one, paying fee + tip for a 6005 off a board it
# is mispricing. Rounds are ~50 slots and healthy lag is 0-2.
# Alert threshold (warning only):
SLOT_LAG_ALERT_SLOTS=30
# Hard gate — refuse to fire above this lag. Auto-recovers; no kill file.
MAX_SNAPSHOT_LAG_SLOTS=10
# Ignore a lag measurement older than this (ms). The gate fails OPEN past it:
# a missing sample means the reference RPC is unreachable, which STALENESS_MS
# already covers, and failing closed would park the bot indefinitely.
SNAPSHOT_LAG_MAX_AGE_MS=30000

# Alert when wallet SOL drops below this
SOL_FLOOR_SOL=0.02

# Reconciliation tripwire: modeled-vs-realized payout tolerance (fraction).
# Sized for full-size deploys; the exact direction checks are always on regardless.
RECONCILE_TOLERANCE=0.25
# Wallet-drift tripwire: unexplained USDC outflow (whole USD) that halts.
WALLET_DRIFT_TOLERANCE_USD=5

# Self-settle deployments after reveal (rent refund to whoever cranks)
SELF_SETTLE=true
# Compound loop: claim won USDC (unclaimed_usd_amount) back to the wallet once it
# exceeds MAX_UNCLAIMED_USD_VALUE, so it re-enters the deployable bankroll and
# Kelly sizes against it next round. claim_usd is fee-free (deploy fees already
# taken) — pure upside, on by default.
CLAIM_USD_ENABLED=true
# BTC-share sweep (claim_sats). Pays the ~10% sats_vault_claim fee, so keep off
# unless realizing BTC beats holding the shares as exposure.
SWEEP_ENABLED=false
CLAIM_FRACTION=0.5
# FALLBACK ONLY — see the price-oracle block below.
BTC_USD_ESTIMATE=65000

# ── Price oracle (Pyth, read over the RPC we already hold) ───────────────────
# BTC price scales every BTC-denominated figure (vault pool values, unclaimed
# position value, the hashrate price derived from them); SOL price sizes Jito
# tips. Both are read live from Pyth's Solana Receiver push accounts — the
# *_USD_ESTIMATE values above are cold-start seeds only. Verify with
# `pnpm prices` (exits non-zero if either symbol isn't live).
# Leave an account blank to disable that feed and pin the symbol to its seed.
# These are the mainnet sponsored feeds, verified live. Do NOT substitute the
# legacy v2 oracle accounts — they still exist but are frozen and never accept.
PYTH_BTC_USD_ACCOUNT=4cSM2e6rvbGQUFiJbqytoVMi5GgghSMr8LwVrT9VPSPo
PYTH_SOL_USD_ACCOUNT=7UVimffxr9ow1uXYxsr4LHAcV58mLzhmwaeKvJ1pjLiE
# Reject an update posted more than this many slots behind head (~150 ≈ 60s).
PRICE_MAX_STALE_SLOTS=150
# Reject a quote whose confidence/price exceeds this (0.02 = 2%).
PRICE_MAX_CONFIDENCE_RATIO=0.02
# Oracle refresh cadence (ms).
PRICE_POLL_MS=30000

# ── Hashrate raffle vaults (epoch + 1-BTC) ───────────────────────────────────
# Master switch. On = spends earned hashrate (an otherwise-idle byproduct of
# deploying) on positive-share raffles, bounded by VAULT_MAX_TICKETS /
# VAULT_HASHRATE_FRACTION and gated by EXECUTION_MODE (dry sends nothing).
# VERIFY ON DEVNET first (EXECUTION_MODE=devnet) — the vault path caught a 100×
# cost error on devnet before. Off = deploy-only, never buys tickets.
VAULT_STRATEGY_ENABLED=true
# USD value of ONE RAW hashrate unit — the on-chain unit (100 raw = 1.00 display
# point; a vault ticket costs 100 raw). Dual use:
#  (1) vault pickiness floor — higher = only enters thinner draws;
#  (2) DEPLOY EV credit, applied per the program's own formula
#        R = s · (m + 21/n)      m = streak (cap 100), n = tiles covered
#      so the credit scales with your streak and is INVERSELY proportional to
#      coverage: 1 tile earns 22 raw/$ at m=1, the whole board earns 2. That's an
#      11x gap, which is why this belongs in the allocation decision and not as a
#      flat per-dollar rebate.
# 0 = DERIVE IT LIVE (recommended). Hashrate has exactly one sink — vault
# tickets — so the bot prices a raw unit as the best marginal ticket EV
# currently on offer across OPEN vaults, divided by the raw units a ticket
# costs. See the "Hashrate value" card on the dashboard for the live figure and
# its provenance (derived / config / none).
# Setting a value here OVERRIDES the derivation and pins it. Only do that if you
# have a better estimate than the live pools — a wrong value corrupts the edge
# the Kelly sizer bets on.
HASHRATE_VALUE_USD=0
# Post-Sat-Strike bonus: the owner awards 2x hashrate for 4h after each Strike,
# with the timer reset by another Strike inside the window. The bot detects the
# trigger from the RoundRevealed event in the same slot it reveals (well before
# the site banner) and scales the hashrate credit for the whole window — so it
# plays more rounds while the bonus is live. 1 = feature off.
# Inert while hashrate prices at zero (no open vault to spend it in).
STRIKE_HASHRATE_MULTIPLIER=2
STRIKE_BONUS_WINDOW_MINUTES=240
# Uplift on epoch ticket EV from wallet-level dedup. Epoch winners are deduped
# by wallet: when a holder is drawn, ALL its tickets leave the pool. With the
# top 10 holding ~71% of tickets, whales are drawn early and vanish, so a small
# holder's odds on later draws are well above its raw ticket share.
# MEASURED 2026-08-15 (127 participants, 668,088 tickets) by simulating the 21
# draws: 1.49x at 144 tickets, 1.42x at 500, 1.46x at 2000. Re-measure with
# `pnpm epoch-uplift` if the field flattens out. 1 = disable.
EPOCH_DEDUP_UPLIFT=1.45
# Hashrate points per vault ticket. Measured on devnet = 100 (buy 5 → 500 spent).
# Verify on mainnet before enabling live.
VAULT_HASHRATE_PER_TICKET=100
# Max tickets to hold in a single vault iteration (risk bound).
VAULT_MAX_TICKETS=250
# Fraction of the wallet's claimable hashrate the vault strategy may spend.
VAULT_HASHRATE_FRACTION=0.5
# Epoch entry window — buy late, after the field's hashrate is committed. The
# FRACTION is what matters on mainnet (iterations are 648_000 slots = 3 DAYS,
# verified against the public API iteration history); the slot count
# is only a floor for short devnet iterations. A fixed 10 slots (~4s) against a
# multi-hour iteration is narrower than the 5s poll, which is how the epoch
# vault ended up dormant.
VAULT_EPOCH_LATE_SLOTS=600
VAULT_EPOCH_LATE_FRACTION=0.001
# Enter the 1-BTC draw only once the vault is this full (bps of the trigger).
VAULT_ONE_BTC_MIN_FILL_BPS=8000
# BTC that triggers the 1-BTC draw. The program hardcodes 1 and the IDL exposes
# no constant, so it lives here as the escape hatch if the game ever changes it.
VAULT_ONE_BTC_TARGET_BTC=1
# Self-crank draws (trigger + epoch winner selection) if the owner's crank is
# absent, so winnings become claimable. Claiming always runs regardless.
VAULT_SELF_CRANK=false

# ── Ops ──────────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
DB_PATH=./data/satrush.db

# ── Read-only monitoring API + dashboard ─────────────────────────────────────
# API is DISABLED unless API_TOKEN is set. Strictly read-only (no control
# endpoints). Bind localhost by default; expose remotely via a tunnel
# (Cloudflare Tunnel / Tailscale), NOT by opening 0.0.0.0.
# Dashboard: http://<host>:<port>/?token=<API_TOKEN>
API_TOKEN=
API_HOST=127.0.0.1
API_PORT=8787
