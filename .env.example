# ── Execution gate ───────────────────────────────────────────────────────────
# dry (default): never sends transactions. devnet: sends on devnet.
# mainnet: sends on mainnet AND requires MAINNET_CONFIRM=yes.
EXECUTION_MODE=dry
# MAINNET_CONFIRM=yes

# ── RPC / streaming ──────────────────────────────────────────────────────────
# Helius: https://mainnet.helius-rpc.com/?api-key=<KEY> (or devnet.helius-rpc.com)
RPC_HTTP_URL=https://api.devnet.solana.com
# Comma-separated fallback/broadcast RPCs
SECONDARY_RPC_URLS=
# Yellowstone-compatible gRPC endpoint + token.
# Helius LaserStream: https://laserstream-<cluster>-<region>.helius-rpc.com
# (verified: mainnet-slc, devnet-ewr; GRPC_TOKEN = the API key)
GRPC_URL=
GRPC_TOKEN=
# Optional Jito block engine for tip-routed sends (bundle path also needs a
# tip account; tips are embedded in the candidate transactions)
JITO_BLOCK_ENGINE_URL=
JITO_TIP_ACCOUNT=
JITO_TIP_LAMPORTS=10000

# Priority fee clamp (micro-lamports per CU) and deploy compute budget
PRIORITY_FEE_MIN_MICROLAMPORTS=1000
PRIORITY_FEE_MAX_MICROLAMPORTS=1000000
DEPLOY_CU_LIMIT=400000

# ── Identity / program ───────────────────────────────────────────────────────
KEYPAIR_PATH=./keypairs/operator.json
PROGRAM_ID=satRushGBRY2vgapeTAkoxz26vL2cYqyPi6CnBj7Tco
# Optional — resolved from the on-chain SatrushConfig when unset
USD_MINT=
BTC_MINT=

# ── Strategy / timing ────────────────────────────────────────────────────────
# water_filling (default) | k_emptiest (fallback)
STRATEGY=water_filling
# TileStake.stake interpretation — ANSWERED: raw net USD (FINDINGS.md E1)
STAKE_SEMANTICS=raw
# Stake sizing multiplier when strike pool exceeds the threshold (1.0 = off)
STRIKE_SIZE_BOOST=1.0
STRIKE_BOOST_THRESHOLD_USD=100
# How many slots before end_slot to fire the deploy.
# Measured (FINDINGS.md E4): floor is 3 on public RPC (2/1/0 → 6005);
# 4 = floor + 1 cushion. Revisit ~2 when colocated with the RPC.
FIRE_OFFSET_SLOTS=4
# Pick among the K emptiest tiles
K_EMPTIEST=3
# Endgame convergence [0..1]: thin tiles don't stay thin — late money and other
# snipers flood the cheapest tiles before close (a $12 board settled near-uniform
# at ~$10/tile once the field arrived). This pulls every below-mean tile this
# fraction of the way to the board mean in the forecast, so the model prices the
# payout dilution a thin snipe actually suffers instead of assuming it owns the
# tile alone. 0 = off (old optimistic behavior). Calibrated from live data where
# wins paid ~2× vs the ~3.1× needed to break even; revisit as the sample grows.
ENDGAME_CONVERGENCE=0.5
# Minimum modeled edge to fire, in bps of the gross deploy. Without it the
# selector fires on any EV>0, including thin edges that a slightly-optimistic
# forecast turns negative in reality. 1000 = require modeled EV >= 10% of stake.
# 0 = off.
MIN_EDGE_BPS=1000
# Anti-collision: fold predicted rival occupancy (from profiled competitor
# behavior) into the selector's forecast so it routes off tiles other snipers
# will crowd. Off = own-observation occupancy only (current behavior).
ANTI_COLLISION_ENABLED=false
# How many recent competitor deploys to profile for anti-collision.
COMPETITOR_LOOKBACK=500
# Comma-separated stake sizes in whole USD, e.g. 1,2,5
STAKE_LADDER_USD=1

# ── Risk limits (load-bearing — enforced in the execution path) ──────────────
MAX_PER_ROUND_USD=1
DAILY_LOSS_CAP_USD=5
# Claim once unclaimed winnings exceed this USD value
MAX_UNCLAIMED_USD_VALUE=50
# If this file exists, all transaction sending halts immediately
KILL_SWITCH_FILE=./KILL

# Ingest streams are considered stale after this many ms without updates
STALENESS_MS=1500

# Alert when wallet SOL drops below this
SOL_FLOOR_SOL=0.02

# Reconciliation tripwire: modeled-vs-realized payout tolerance (fraction).
# Sized for full-size deploys; the exact direction checks are always on regardless.
RECONCILE_TOLERANCE=0.25
# Wallet-drift tripwire: unexplained USDC outflow (whole USD) that halts.
WALLET_DRIFT_TOLERANCE_USD=5

# Self-settle deployments after reveal (rent refund to whoever cranks)
SELF_SETTLE=true
# Claim sweep — keep off until claim-fee vs hashrate tradeoffs are measured
SWEEP_ENABLED=false
CLAIM_FRACTION=0.5
BTC_USD_ESTIMATE=100000

# ── Hashrate raffle vaults (epoch + 1-BTC) — OFF by default ──────────────────
# Master switch. Off = the bot never buys vault tickets (deploy-only).
VAULT_STRATEGY_ENABLED=false
# USD opportunity value of one hashrate point — the pickiness floor. Higher =
# only enters thinner draws (saves hashrate for better ones). 0 = enter on any
# positive share.
HASHRATE_VALUE_USD=0
# Hashrate points per vault ticket. Measured on devnet = 100 (buy 5 → 500 spent).
# Verify on mainnet before enabling live.
VAULT_HASHRATE_PER_TICKET=100
# Max tickets to hold in a single vault iteration (risk bound).
VAULT_MAX_TICKETS=100
# Fraction of the wallet's claimable hashrate the vault strategy may spend.
VAULT_HASHRATE_FRACTION=0.5
# Enter the epoch draw only within this many slots of the window closing (buy
# late, after the field's hashrate is committed).
VAULT_EPOCH_LATE_SLOTS=10
# Enter the 1-BTC draw only once the vault is this full (bps of the trigger).
VAULT_ONE_BTC_MIN_FILL_BPS=8000
# Self-crank draws (trigger + epoch winner selection) if the owner's crank is
# absent, so winnings become claimable. Claiming always runs regardless.
VAULT_SELF_CRANK=false

# ── Ops ──────────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
DB_PATH=./data/satrush.db

# ── Read-only monitoring API + dashboard ─────────────────────────────────────
# API is DISABLED unless API_TOKEN is set. Strictly read-only (no control
# endpoints). Bind localhost by default; expose remotely via a tunnel
# (Cloudflare Tunnel / Tailscale), NOT by opening 0.0.0.0.
# Dashboard: http://<host>:<port>/?token=<API_TOKEN>
API_TOKEN=
API_HOST=127.0.0.1
API_PORT=8787
